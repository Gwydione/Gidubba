<UserControl x:Class="TableForge.Views.RollView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TableForge.Views">
    <UserControl.Resources>
        <SolidColorBrush x:Key="MatchBrush" Color="#DFF1E1" />
        <!-- A used Unique row: a light gray background and muted text that still reads clearly on it (about 5.6:1). -->
        <SolidColorBrush x:Key="UsedBrush" Color="#EEEEEE" />
        <SolidColorBrush x:Key="UsedText" Color="#5F5F5F" />
        <SolidColorBrush x:Key="ProblemText" Color="#A00000" />
        <SolidColorBrush x:Key="WarningText" Color="#7A5200" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- Aligned columns share the width left after each row's 4 px padding either side and its 90 px range column. -->
        <views:AlignedColumnWidth x:Key="AlignedWidth" Fixed="98" Gap="0" />
        <!-- A row's result text in the table listing: a used Unique row stays fully readable, only muted (its "Used" tag says why).
             The row just rolled keeps normal text on its green highlight, used or not. -->
        <Style x:Key="UniqueEntryText" TargetType="TextBlock">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsUsed}" Value="True" />
                        <Condition Binding="{Binding IsMatched}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{StaticResource UsedText}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <!-- The same for one cell of an aligned table: only the row knows it was rolled (one roll is one row of every set). -->
        <Style x:Key="AlignedUniqueEntryText" TargetType="TextBlock">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsUsed}" Value="True" />
                        <Condition Binding="{Binding DataContext.IsMatched, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{StaticResource UsedText}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <!-- A row's "Unique" or "Used" tag: a small, quiet pill after its result text, read as a label on the row rather than as more
             of its text. Used is a neutral gray pill with a hairline edge so it still shows on a used row's gray. -->
        <Style x:Key="UniqueTagPill" TargetType="Border">
            <Setter Property="Background" Value="#E8EEF6" />
            <Setter Property="BorderBrush" Value="#D3DDEA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="6,0,6,1" />
            <Setter Property="Margin" Value="6,1,0,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUsed}" Value="True">
                    <Setter Property="Background" Value="#E2E2E2" />
                    <Setter Property="BorderBrush" Value="#CCCCCC" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="UniqueTagLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#3A5573" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUsed}" Value="True">
                    <Setter Property="Foreground" Value="#555555" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="TrailScroller" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="TrailContent" Margin="16">

            <!-- The trail: every table rolled so far in this linked sequence, oldest first. -->
            <ItemsControl x:Name="StepsList" ItemsSource="{Binding Steps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="↓" FontSize="22" Foreground="#888" Margin="0,0,0,6">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFirst}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Only for a step auto-follow opened: a compact note of where it came from (the parent's result is on the step above). -->
                            <TextBlock x:Name="AutoFollowedFromText" Text="{Binding AutoFollowedFrom}" Foreground="#666" FontStyle="Italic"
                                       TextWrapping="Wrap" Margin="0,0,0,2"
                                       Visibility="{Binding IsAutoFollowed, Converter={StaticResource BoolToVis}}" />
                            <!-- Only for a step Back to the original table added. -->
                            <TextBlock x:Name="ReturnedText" Text="Back to the original table" Foreground="#666" FontStyle="Italic"
                                       TextWrapping="Wrap" Margin="0,0,0,2"
                                       Visibility="{Binding IsReturn, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DiceInfo}" Foreground="#666" Margin="0,2,0,8" />
                            <!-- The table's own description, when it has one: secondary, plain, wrapping. Collapsed (no space at all) when empty. -->
                            <TextBlock x:Name="DescriptionText" Text="{Binding Description}" Foreground="#666" TextWrapping="Wrap" Margin="0,-4,0,8"
                                       Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />
                            <!-- A Manual-selection table: a small hint that its result is meant to be chosen. Roll still works as always. -->
                            <TextBlock x:Name="ManualSelectionHint" Text="Manual-selection table: choose the result and enter it below."
                                       Foreground="{StaticResource WarningText}" TextWrapping="Wrap" Margin="0,-4,0,8"
                                       Visibility="{Binding IsManualSelection, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="Not rolled yet." Foreground="#888" FontStyle="Italic" Margin="0,0,0,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasOutcomes}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Each roll is shown once, followed by the output of every result set. -->
                            <ItemsControl ItemsSource="{Binding Outcomes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <!-- "Roll 2": only for the results of one Roll action that made several rolls, each kept separate. -->
                                            <TextBlock x:Name="BatchLabelText" Text="{Binding BatchLabel}" FontWeight="SemiBold" Foreground="#333" Margin="0,4,0,2"
                                                       Visibility="{Binding HasBatchLabel, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding Display}" FontSize="16" Foreground="#555" Margin="0,0,0,4" />
                                            <!-- Only for a roll that used a situational modifier: how the final number was reached. -->
                                            <TextBlock Text="{Binding Breakdown}" Foreground="#555" Margin="0,-2,0,4"
                                                       Visibility="{Binding HasBreakdown, Converter={StaticResource BoolToVis}}" />
                                            <!-- Only for a roll the table's Clamp to Range looked up at a boundary: the number above stays
                                                 what was calculated; this is the value the table was resolved with. -->
                                            <TextBlock x:Name="ClampNoteText" Text="{Binding ClampNote}" Foreground="#555" FontWeight="SemiBold" Margin="0,-2,0,4"
                                                       Visibility="{Binding HasClampNote, Converter={StaticResource BoolToVis}}" />
                                            <!-- Only for a result that took rerolls: used Unique results came up first and were rolled again.
                                                 The rejected throws themselves are never shown. -->
                                            <TextBlock x:Name="RerollNoteText" Text="{Binding RerollNote}" Foreground="#555" Margin="0,-2,0,4"
                                                       ToolTip="Used Unique results came up first, so the same dice were rolled again."
                                                       Visibility="{Binding HasRerollNote, Converter={StaticResource BoolToVis}}" />
                                            <ItemsControl ItemsSource="{Binding Lines}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,0,0,8">
                                                            <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" Foreground="#555"
                                                                       Visibility="{Binding HasHeading, Converter={StaticResource BoolToVis}}" />
                                                            <TextBlock views:FormattedText.Segments="{Binding Segments}" FontSize="26" TextWrapping="Wrap">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource ProblemText}" />
                                                                                <Setter Property="FontSize" Value="18" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <!-- The text above with each rolled inline expression replaced in place by its latest value
                                                                 ("You gain +3 Armor"). A transient, subordinate copy: the text above never changes. -->
                                                            <TextBlock x:Name="ResolvedInlineText" views:FormattedText.Segments="{Binding ResolvedSegments}"
                                                                       FontSize="18" Foreground="#555" TextWrapping="Wrap" Margin="0,4,0,0"
                                                                       Visibility="{Binding ShowResolved, Converter={StaticResource BoolToVis}}" />
                                                            <!-- Dice expressions found inside the text above, offered as separate, user-triggered rolls. -->
                                                            <ItemsControl ItemsSource="{Binding InlineActions}" Margin="0,4,0,0"
                                                                          Visibility="{Binding ShowInlineActions, Converter={StaticResource BoolToVis}}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Content="{Binding RollLabel}" Command="{Binding RollCommand}"
                                                                                Padding="10,3" Margin="0,2,8,0" VerticalAlignment="Center" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <!-- A link is only ever followed by the user, and never rolls the destination. -->
                                                            <Button Content="{Binding FollowLabel}" Command="{Binding FollowCommand}"
                                                                    HorizontalAlignment="Left" Padding="14,5" Margin="0,4,0,0"
                                                                    Visibility="{Binding ShowFollow, Converter={StaticResource BoolToVis}}" />
                                                            <TextBlock Text="{Binding LinkedNote}" Foreground="#777" Margin="0,2,0,0"
                                                                       Visibility="{Binding ShowLinkedNote, Converter={StaticResource BoolToVis}}" />
                                                            <TextBlock Text="{Binding UnresolvedNote}" Foreground="{StaticResource WarningText}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                                       Visibility="{Binding ShowUnresolved, Converter={StaticResource BoolToVis}}" />
                                                            <TextBlock Text="⚠ The linked table no longer exists." Foreground="{StaticResource WarningText}" Margin="0,4,0,0"
                                                                       Visibility="{Binding ShowMissing, Converter={StaticResource BoolToVis}}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Rolling always applies to the current (last) table in the trail. -->
            <StackPanel x:Name="RollControls" Margin="0,6,0,0">
            <!-- Only after a link was followed (by hand or by auto-follow): back to the table this screen was opened on, as a new
                 step below. Earlier results stay; nothing is rolled; it never happens by itself. -->
            <Button x:Name="ReturnToOriginalButton" Content="{Binding ReturnToOriginalLabel}" Command="{Binding ReturnToOriginalCommand}"
                    HorizontalAlignment="Left" Padding="12,4" Margin="0,0,0,10"
                    ToolTip="Make the table you started from the current table again. Earlier results stay where they are."
                    Visibility="{Binding ShowReturnToOriginal, Converter={StaticResource BoolToVis}}" />
            <StackPanel Orientation="Horizontal">
                <!-- How many independent rolls one Roll makes: chosen by the person (1 by default), never read from a table's text.
                     Manual entry is always one typed result and ignores it. -->
                <TextBlock Text="Rolls:" Foreground="#666" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="RollCountBox" ItemsSource="{Binding RollCountOptions}" SelectedItem="{Binding RollCount}" Width="52"
                          VerticalAlignment="Center" Margin="0,0,10,0" IsEnabled="{Binding IsRollCountEditable}"
                          AutomationProperties.Name="Number of rolls" ToolTip="How many times Roll rolls this table (each result is kept separately)" />
                <Button x:Name="RollButton" Content="{Binding RollButtonLabel}" FontSize="18" Padding="32,8" Command="{Binding RollCommand}" />
                <!-- A temporary situational modifier for the next Roll only: added after the dice, then reset to 0. Not for d66,
                     manual entry or inline rolls, and locked while a roll is in the air (that roll already took its value). -->
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding IsModifierAvailable, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Modifier:" Foreground="#666" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="ModifierBox" Width="54" Padding="4" VerticalContentAlignment="Center"
                             AutomationProperties.Name="Situational modifier"
                             ToolTip="Added to the next Roll only (for example +2 or -1), then reset to 0. Not used by a typed roll."
                             IsEnabled="{Binding IsModifierEditable}"
                             Text="{Binding ModifierText, UpdateSourceTrigger=PropertyChanged, NotifyOnTargetUpdated=True}"
                             GotKeyboardFocus="OnModifierGotKeyboardFocus" PreviewMouseLeftButtonDown="OnModifierPreviewMouseDown"
                             TargetUpdated="OnModifierTargetUpdated">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding RollCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>
                <!-- Shown only while a visual (dddice) roll is in the air; the table result appears when the dice settle. -->
                <TextBlock x:Name="RollStatusText" Text="{Binding RollStatus}" AutomationProperties.AutomationId="RollStatus"
                           FontSize="16" Foreground="#555" VerticalAlignment="Center" Margin="14,0,0,0" />
                <!-- Stop: only while something is under way (a roll, several rolls, an inline roll or an auto-follow chain). -->
                <Button x:Name="StopButton" Content="Stop" Padding="12,4" Margin="10,0,0,0" VerticalAlignment="Center" Command="{Binding StopCommand}"
                        ToolTip="Stop the roll or auto-follow under way" Visibility="{Binding IsRolling, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="or enter a roll:" Foreground="#666" VerticalAlignment="Center" Margin="24,0,8,0" />
                <TextBox x:Name="ManualBox" Width="70" Padding="4" VerticalContentAlignment="Center"
                         Text="{Binding ManualRollText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding ResolveManualCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Content="Resolve" Padding="14,6" Margin="8,0,0,0" Command="{Binding ResolveManualCommand}" />
            </StackPanel>
            <!-- Only for a table with Unique rows: how many are used, and Reset (confirmed; the Unique setting itself is never changed here).
                 Part of the Roll controls, so it stays in view after every roll. -->
            <WrapPanel x:Name="UsedResultsBar" Margin="0,8,0,0" Visibility="{Binding HasUniqueRows, Converter={StaticResource BoolToVis}}">
                <TextBlock x:Name="UsedResultsSummaryText" Text="{Binding UsedResultsSummary}" Foreground="#555" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button x:Name="ResetUsedResultsButton" Content="Reset Used Results…" Padding="10,2" VerticalAlignment="Center"
                        Command="{Binding ResetUsedResultsCommand}"
                        ToolTip="Make every used Unique result of this table available to roll again. Which rows are Unique does not change." />
            </WrapPanel>
            <!-- One app-wide setting, remembered between sessions. Off is exactly the behavior Gidubba always had. -->
            <CheckBox x:Name="AutoFollowBox" Content="Auto-follow linked tables" IsChecked="{Binding AutoFollow.IsOn}" Margin="0,8,0,0"
                      HorizontalAlignment="Left"
                      ToolTip="After a roll or a result you enter, open its one linked table and roll it, and so on. Manual-selection tables are opened but not rolled." />
            <TextBlock x:Name="ModifierErrorText" Text="{Binding ModifierError}" Foreground="{StaticResource ProblemText}" Margin="0,6,0,0"
                       Visibility="{Binding HasModifierError, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding Message}" Foreground="{StaticResource ProblemText}" Margin="0,6,0,0" />
            </StackPanel>

            <WrapPanel Margin="0,24,0,6">
                <TextBlock Text="{Binding Title, StringFormat=Table: {0}}" FontWeight="SemiBold" Foreground="#555" VerticalAlignment="Center" Margin="0,0,16,0" />
                <!-- Export…: one result set of this table, as plain text, Sojour rows, Foundry VTT JSON or Owlbear Rodeo Tables+ JSON, or the whole
                     table as a PUM Companion bundle. Read-only: rolls and results are untouched. -->
                <ComboBox x:Name="CopyResultSetBox" ItemsSource="{Binding CopyResultSetNames}" SelectedIndex="{Binding CopyResultSetIndex}"
                          MinWidth="120" Margin="0,0,6,0" VerticalAlignment="Center"
                          AutomationProperties.Name="Result set to export" ToolTip="Which result set Export… copies or saves"
                          Visibility="{Binding ShowCopyResultSetChoice, Converter={StaticResource BoolToVis}}" />
                <Button x:Name="ExportButton" Content="Export…" Padding="10,2" VerticalAlignment="Center" Click="OnExportClick"
                        ToolTip="Copy this table as plain text, as rows for a Sojour Lookup Table, or as JSON for Foundry VTT's Roll Table Importer or Owlbear Rodeo (Tables+), or save it for PUM Companion">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="ExportMenu">
                            <MenuItem Header="Copy Table Text" Command="{Binding CopyTableTextCommand}"
                                      ToolTip="Plain text: name, dice, then one range and result per line" />
                            <MenuItem Header="Copy Table Text (Spaces)" Command="{Binding CopyTableTextSpacesCommand}"
                                      ToolTip="The same plain text, with one space instead of a tab between each range and its result" />
                            <MenuItem Header="Copy for Sojour" Command="{Binding CopyForSojourCommand}"
                                      ToolTip="Only the rows, range and result per line, to paste with Ctrl+V into a Sojour Lookup Table" />
                            <Separator />
                            <MenuItem Header="Copy Foundry JSON" Command="{Binding CopyFoundryJsonCommand}"
                                      ToolTip="JSON to paste into Foundry VTT's Roll Table Importer" />
                            <MenuItem Header="Save Foundry JSON…" Command="{Binding SaveFoundryJsonCommand}"
                                      ToolTip="The same JSON, saved as a .json file for Roll Table Importer" />
                            <Separator />
                            <MenuItem Header="Copy Tables+ JSON" Command="{Binding CopyTablesPlusJsonCommand}"
                                      ToolTip="JSON to import into Owlbear Rodeo (Tables+)" />
                            <MenuItem Header="Save Tables+ JSON…" Command="{Binding SaveTablesPlusJsonCommand}"
                                      ToolTip="The same JSON, saved as a .json file to import into Owlbear Rodeo (Tables+)" />
                            <Separator />
                            <MenuItem Header="Save PUM Companion Bundle…" Command="{Binding SavePumBundleCommand}"
                                      ToolTip="A .pumb file to import into PUM Companion. Exports the whole table, every result set." />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <TextBlock x:Name="CopyMessageText" Text="{Binding CopyMessage}" Foreground="#2E6B3A" VerticalAlignment="Center" Margin="8,0,0,0"
                           Visibility="{Binding HasCopyMessage, Converter={StaticResource BoolToVis}}" />
            </WrapPanel>
            <TextBlock x:Name="ExportWarningText" Text="{Binding ExportWarning}" Foreground="{StaticResource WarningText}" TextWrapping="Wrap"
                       Margin="0,0,0,6" Visibility="{Binding HasExportWarning, Converter={StaticResource BoolToVis}}" />

            <!-- Result sets that are genuine parallel outputs of one roll (same row count, same range at every row):
                 shown as one aligned multi-column grid instead of separate stacked sections, mirroring the Review
                 screen (see RollStepViewModel.IsAligned). Each column is still its own independent result set
                 underneath — only the presentation is grouped. -->
            <!-- The aligned table scrolls sideways on its own when its columns (never under 230 px) do not fit; headings and rows
                 scroll together. The page above still takes the mouse wheel (see OnAlignedMouseWheel). -->
            <ScrollViewer x:Name="AlignedRollScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          Focusable="False" PreviewMouseWheel="OnAlignedMouseWheel"
                          Visibility="{Binding IsAligned, Converter={StaticResource BoolToVis}}">
            <StackPanel>
            <!-- Laid out exactly like a row below (4 px padding, the 90 px range column, then the columns), so each heading sits
                 over its own column at any width. -->
            <Border Padding="4,0" Margin="0,0,0,2">
                <StackPanel Orientation="Horizontal">
                    <Border Width="90" />
                    <ItemsControl x:Name="AlignedRollHeaders" ItemsSource="{Binding ResultSets}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="AlignedRollHeader" Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" Padding="0,0,6,0">
                                    <TextBlock.Width>
                                        <MultiBinding Converter="{StaticResource AlignedWidth}">
                                            <Binding Path="ViewportWidth" RelativeSource="{RelativeSource AncestorType=ScrollViewer}" />
                                            <Binding Path="DataContext.ResultSets.Count" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        </MultiBinding>
                                    </TextBlock.Width>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <ItemsControl x:Name="AlignedRollRowsList" ItemsSource="{Binding AlignedRows}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="4,2" CornerRadius="3">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMatched}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource MatchBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding RangeLabel}" FontFamily="Consolas" Foreground="#555" Width="90" />
                                <ItemsControl ItemsSource="{Binding Cells}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Each cell is its own result set's row, so each is gray on its own when used; never over the
                                                 rolled row's green. The negative margin keeps the text exactly under its column heading. -->
                                            <Border x:Name="AlignedCell" Padding="2,0" Margin="-2,0,2,0" CornerRadius="3">
                                                <Border.Width>
                                                    <MultiBinding Converter="{StaticResource AlignedWidth}">
                                                        <Binding Path="ViewportWidth" RelativeSource="{RelativeSource AncestorType=ScrollViewer}" />
                                                        <Binding Path="DataContext.ResultSets.Count" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                    </MultiBinding>
                                                </Border.Width>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsUsed}" Value="True" />
                                                                    <Condition Binding="{Binding DataContext.IsMatched, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="False" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Background" Value="{StaticResource UsedBrush}" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <!-- The tag follows the cell's text, and goes under it when a long result leaves no room. -->
                                                <WrapPanel>
                                                    <TextBlock views:FormattedText.Segments="{Binding Segments}" TextWrapping="Wrap" Style="{StaticResource AlignedUniqueEntryText}" />
                                                    <Border x:Name="UniqueTagPill" Style="{StaticResource UniqueTagPill}" Visibility="{Binding HasUniqueTag, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock x:Name="UniqueTagText" Text="{Binding UniqueTag}" Style="{StaticResource UniqueTagLabel}" />
                                                    </Border>
                                                </WrapPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
            </ScrollViewer>

            <!-- Single result set, or several independent sets that are not parallel outputs (e.g. Ambient/Noise):
                 shown one at a time, stacked, as before. -->
            <ItemsControl x:Name="ResultSetsList" ItemsSource="{Binding ResultSets}"
                          Visibility="{Binding IsNotAligned, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,0,2"
                                       Visibility="{Binding HasName, Converter={StaticResource BoolToVis}}" />
                            <ItemsControl ItemsSource="{Binding Entries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="EntryRow" Padding="4,2" CornerRadius="3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <!-- Used is gray across the whole row; the rolled row's green comes after it, so it wins. -->
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUsed}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource UsedBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsMatched}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource MatchBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding RangeLabel}" FontFamily="Consolas" Foreground="#555" />
                                                <!-- The tag follows the text it belongs to, and goes under it when a long result leaves no room. -->
                                                <WrapPanel Grid.Column="1">
                                                    <TextBlock views:FormattedText.Segments="{Binding Segments}" TextWrapping="Wrap"
                                                               Style="{StaticResource UniqueEntryText}" />
                                                    <!-- "Unique" or "Used" (words, so never colour alone); nothing for a repeatable row. -->
                                                    <Border x:Name="UniqueTagPill" Style="{StaticResource UniqueTagPill}" Visibility="{Binding HasUniqueTag, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock x:Name="UniqueTagText" Text="{Binding UniqueTag}" Style="{StaticResource UniqueTagLabel}" />
                                                    </Border>
                                                </WrapPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
